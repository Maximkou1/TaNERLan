# Required for both the API container and the local vLLM container.
VLLM_MODEL=cyankiwi/Qwen3.8-27B-AWQ-INT4
VLLM_IMAGE=vllm/vllm-openai:v0.11.0

# Optional for private Hugging Face models.
HF_TOKEN=
VLLM_API_KEY=local-internal-key

# API/runtime tuning. Adjust after learning the target GPU VRAM.
API_PORT=8000
VLLM_QUANTIZATION=awq
VLLM_MAX_MODEL_LEN=4096
VLLM_TIMEOUT=120
VLLM_RETRIES=3
VLLM_CONCURRENCY=1
LLM_MAX_BATCH_ITEMS=8
LLM_MAX_TOKENS=1024
LLM_THINKING=0
LLM_RULES=tailvocab,geoorg
